GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key
# AWS Textract DetectDocumentText
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
